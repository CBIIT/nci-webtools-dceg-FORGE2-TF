# cdk.env — DEV tier, account 201624419975 (nonprod)
#
# Pre-filled with everything I could derive. Replace every <FILL_ME ...> with a
# real value (get the imported VPC / subnets / SG / cluster / listener / app-role
# from the platform team), then upload to S3 where the workflows read it:
#
#   aws s3 cp infrastructure/cdk.env \
#     s3://<CICD_BUCKET>/env/dev/forge2-tf/cdk.env --profile dceg
#
# This file is git-ignored (**/cdk.env), so it will not be committed.
# For qa, copy this file, set TIER=qa and APP_DOMAIN=analysistools-qa.cancer.gov,
# and upload to .../env/qa/forge2-tf/cdk.env.

# --- Required by bin/cdk.ts and bin/ecr.ts ---
TIER=dev
AWS_ACCOUNT_ID=201624419975
AWS_REGION=us-east-1

# --- Application identity (stable across tiers except APP_DOMAIN) ---
APP_NAME=forge2-tf
APP_NAMESPACE=analysistools
APP_SERVICE=web
APP_DOMAIN=analysistools-dev.cancer.gov
APP_PATH_PREFIX=/forge2-tf

# --- Imported shared resources (MUST come from the platform team) ---
VPC_ID=vpc-29a12251
SUBNET_IDS=subnet-4f35f112,subnet-409a0424
SECURITY_GROUP_IDS=sg-0af8bf5fca57a6be2
CLUSTER_ARN=arn:aws:ecs:us-east-1:201624419975:cluster/analysistools-dev
LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:201624419975:listener/app/DEV-D-Appli-Q7A93OTG0I3E/04d617448915352a/1025eebd28ec760e
APP_ROLE_ARN=arn:aws:iam::201624419975:role/power-user-analysistools-role-dev   # shared AT role (used by all analysistools apps)

# --- ALB routing / health check ---
LISTENER_RULE_PRIORITY=900          # must be UNIQUE per listener across all apps
HEALTH_CHECK_PATH=/forge2-tf/
GRACE_PERIOD=120

# --- Task sizing ---
WEB_CPU=1024
WEB_MEMORY=2048
WEB_DESIRED_COUNT=1
WEB_CONTAINER_PORT=80

# --- Non-prod scheduled scale (fine to leave on for dev) ---
WEB_NON_PROD_SCHEDULE=true
SCHEDULED_MIN_CAPACITY=1
SCHEDULED_MAX_CAPACITY=1

# --- ECR (bin/ecr.ts) ---
ECR_REPO_NAME=forge2-tf
ECR_COUNT_NUMBER=10
