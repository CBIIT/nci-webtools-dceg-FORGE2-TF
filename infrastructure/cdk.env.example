# Example CDK environment file.
#
# In CI this file is downloaded per-tier from S3:
#   s3://${CICD_BUCKET}/env/${TIER}/forge2-tf/cdk.env
# and sourced before `cdk deploy`. Copy to cdk.env for local synth/deploy.

# Required by bin/cdk.ts and bin/ecr.ts
TIER=dev
AWS_ACCOUNT_ID=000000000000
AWS_REGION=us-east-1

# Application identity
APP_NAME=forge2-tf
APP_NAMESPACE=analysistools
APP_SERVICE=web
APP_DOMAIN=analysistools-dev.cancer.gov
APP_PATH_PREFIX=/forge2-tf

# Imported shared network / cluster / ALB / IAM resources
VPC_ID=vpc-xxxxxxxx
SUBNET_IDS=subnet-aaaa,subnet-bbbb
SECURITY_GROUP_IDS=sg-xxxxxxxx
CLUSTER_ARN=arn:aws:ecs:us-east-1:000000000000:cluster/analysistools-dev
LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:listener/app/.../...
APP_ROLE_ARN=arn:aws:iam::000000000000:role/analysistools-dev-forge2-tf-role

# Imported EFS (platform-provisioned per tier)
EFS_ID=fs-xxxxxxxxxxxxxxxxx
POSIX_UID=1000
POSIX_GID=1000

# ALB routing / health check
LISTENER_RULE_PRIORITY=900
HEALTH_CHECK_PATH=/forge2-tf/
GRACE_PERIOD=120

# Task sizing
WEB_CPU=1024
WEB_MEMORY=2048
WEB_DESIRED_COUNT=1
WEB_CONTAINER_PORT=80

# Non-prod scheduled scale-to-zero (nights/weekends)
WEB_NON_PROD_SCHEDULE=true
SCHEDULED_MIN_CAPACITY=1
SCHEDULED_MAX_CAPACITY=1

# ECR (bin/ecr.ts)
ECR_REPO_NAME=forge2-tf
ECR_COUNT_NUMBER=10
